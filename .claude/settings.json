{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"Z:/ek559/nys_algal_bloom/NYS algal bloom/code2/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-raw-data.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"Z:/ek559/nys_algal_bloom/NYS algal bloom/code2/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-reminder.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"Z:/ek559/nys_algal_bloom/NYS algal bloom/code2/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-reminder.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"Z:/ek559/nys_algal_bloom/NYS algal bloom/code2/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact.py\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/notify.sh\""
          }
        ]
      }
    ]
  }
}
